# Vibe-Trading LXC — Beispiel-Konfiguration (agent/.env)
# Wird beim Setup nach /opt/vibe-trading/upstream/agent/.env kopiert (falls leer).
# Bequemer: alles in der Web UI unter Settings eintragen — dieselben Keys.
# Volle Referenz: Upstream agent/.env.example + agent/src/config/env_schema.py

# --- Provider (EINEN Block wählen) ---
LANGCHAIN_PROVIDER=openrouter
LANGCHAIN_MODEL_NAME=deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=sk-or-...hier
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI ---
# LANGCHAIN_PROVIDER=openai
# LANGCHAIN_MODEL_NAME=gpt-5.5-instant
# OPENAI_API_KEY=sk-xxx

# --- Anthropic ---
# LANGCHAIN_PROVIDER=anthropic
# LANGCHAIN_MODEL_NAME=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-xxx

# --- DeepSeek ---
# LANGCHAIN_PROVIDER=deepseek
# LANGCHAIN_MODEL_NAME=deepseek-v4-pro
# DEEPSEEK_API_KEY=sk-xxx

# --- Gemini ---
# LANGCHAIN_PROVIDER=gemini
# LANGCHAIN_MODEL_NAME=gemini-3.5-flash
# GEMINI_API_KEY=xxx

# --- Lokale Modelle (Ollama auf dem Proxmox-Host oder eigenem Host) ---
# Im LXC ist "localhost" der Container — Host per LXC-IP ansprechen, z. B.:
# OLLAMA_BASE_URL=http://192.168.1.1:11434
# LANGCHAIN_PROVIDER=ollama

# --- Optional: API-Schutz für LAN-Zugriff ---
# Ohne Key: Loopback-Dev-Modus (Browser am gleichen Host/Origin OK).
# Mit Key: auch nicht-lokale API-Zugriffe brauchen den Key.
# API_AUTH_KEY=
# API_ALLOWED_HOSTS=
